  m_Name: Nervosity
  m_EditorClassIdentifier: Assembly-CSharp::Dialogues.DialogueNode
  speaker: {fileID: 11400000, guid: ebc351b868b44c14cb175d1c4ca66aea, type: 2}
  text: "Ok, ok (on l'a fait) (on l'a vraiment fait\u2026 on l' fait). Pourquoi on
    est toujours coinc\xE9 avec lui ?"
  nextNode: {fileID: -2760618989452385233}
  position: {x: 168, y: 223}
  choices: []
  enterEffects: []
  references:
    version: 2
    RefIds: []
--- !u!114 &-7806596996500614675
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7c7fcd37765e46e2b5a24bd2652ca069, type: 3}
  m_Name: Nervosity
  m_EditorClassIdentifier: Assembly-CSharp::Dialogues.DialogueNode
  speaker: {fileID: 11400000, guid: ebc351b868b44c14cb175d1c4ca66aea, type: 2}
  text: "Oui\u2026 Elle rab\xE2che toujours les m\xEAmes choses : \"Tu aurais pu
    faire mieux\u2026 T'es pas assez\u2026. ( - Ma vie aurait \xE9tait tellement
    mieux si tu n'avais pas \xE9t\xE9 l\xE0) "
  nextNode: {fileID: 8580182924079557654}
  position: {x: 4458, y: 338}
  choices: []
  enterEffects: []
  references:
    version: 2
    RefIds: []
--- !u!114 &-7446386652919575502
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
