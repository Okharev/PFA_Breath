  m_Name: Serenity
  m_EditorClassIdentifier: Assembly-CSharp::Dialogues.DialogueNode
  speaker: {fileID: 11400000, guid: b7f3cfd0c7b90b844b1a440812b055a7, type: 2}
  text: "La vie n'est que souffrance, ch\xE9ri."
  nextNode: {fileID: -5512483433569452920}
  position: {x: 6239, y: 1235}
  choices: []
  enterEffects: []
  references:
    version: 2
    RefIds: []
--- !u!114 &-606458228070908676
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7c7fcd37765e46e2b5a24bd2652ca069, type: 3}
  m_Name: Serenity
  m_EditorClassIdentifier: Assembly-CSharp::Dialogues.DialogueNode
  speaker: {fileID: 11400000, guid: b7f3cfd0c7b90b844b1a440812b055a7, type: 2}
  text: "Il est adorable, mais il  met du temps \xE0 percuter\u2026"
  nextNode: {fileID: 4548739437749643691}
  position: {x: 1240, y: 257}
  choices: []
  enterEffects: []
  references:
