  speaker: {fileID: 11400000, guid: a16b1aa75a9227743a738bb8fc595bf2, type: 2}
  text: "Tu peux souffler maintenant. Tu peux arr\xEAter de porter \xE7a sur tes
    \xE9paules."
  nextNode: {fileID: -5561674351029705082}
  position: {x: 8963, y: 1201}
  choices: []
  enterEffects: []
  references:
    version: 2
    RefIds: []
--- !u!114 &-3548920992261646744
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7c7fcd37765e46e2b5a24bd2652ca069, type: 3}
  m_Name: Loneliness
  m_EditorClassIdentifier: Assembly-CSharp::Dialogues.DialogueNode
  speaker: {fileID: 11400000, guid: 05d8191cc2e06d44bb2a85359d8959a1, type: 2}
  text: "La mer n'avait pas encore d\xE9bord\xE9e, on pouvait se balader de partout"
  nextNode: {fileID: -6663430760397525646}
  position: {x: 4779, y: 996}
  choices: []
  enterEffects: []
  references:
    version: 2
    RefIds: []
--- !u!114 &-2760618989452385233
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7c7fcd37765e46e2b5a24bd2652ca069, type: 3}
  m_Name: Loneliness
  m_EditorClassIdentifier: Assembly-CSharp::Dialogues.DialogueNode
  speaker: {fileID: 11400000, guid: 05d8191cc2e06d44bb2a85359d8959a1, type: 2}
  text: "J'aimerai faire remarquer qu'effectivement, il a bien gal\xE9r\xE9 sur le
    combat d'aujourd'hui."
  nextNode: {fileID: 998740993457969991}
  position: {x: 522, y: 231}
  choices: []
  enterEffects: []
  references:
    version: 2
    RefIds: []
--- !u!114 &-2060049480471558956
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7c7fcd37765e46e2b5a24bd2652ca069, type: 3}
  m_Name: Agressivity
  m_EditorClassIdentifier: Assembly-CSharp::Dialogues.DialogueNode
  speaker: {fileID: 11400000, guid: a16b1aa75a9227743a738bb8fc595bf2, type: 2}
  text: "C'\xE9tait pas juste, ce qu'elle a dit. C'\xE9tait pas juste, et personne
    ne l'a fait remarquer"
  nextNode: {fileID: -8973589388903960247}
  position: {x: 5300, y: 757}
  choices: []
  enterEffects: []
  references:
    version: 2
    RefIds: []
--- !u!114 &-1993701923927617198
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7c7fcd37765e46e2b5a24bd2652ca069, type: 3}
  m_Name: Agressivity
  m_EditorClassIdentifier: Assembly-CSharp::Dialogues.DialogueNode
  speaker: {fileID: 11400000, guid: a16b1aa75a9227743a738bb8fc595bf2, type: 2}
  text: "Ce que tu ne peux pas contr\xF4ler ne devrait pas te consumer. Mes vieux
    os le savent maintenant. "
  nextNode: {fileID: 0}
  position: {x: 10288, y: 1435}
  choices: []
  enterEffects:
  - rid: 1439626105688948813
