--- !u!114 &3867892947391829027
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7c7fcd37765e46e2b5a24bd2652ca069, type: 3}
  m_Name: Nervosity
  m_EditorClassIdentifier: Assembly-CSharp::Dialogues.DialogueNode
  speaker: {fileID: 11400000, guid: ebc351b868b44c14cb175d1c4ca66aea, type: 2}
  text: "(Je me rappelle). Je me rappelle d'une terre fleurie, et de prairies ensoleill\xE9es
    (comme un printemps \xE9ternel)"
  nextNode: {fileID: -6299995327039634063}
  position: {x: 4110, y: 908}
  choices: []
  enterEffects: []
  references:
    version: 2
    RefIds: []
--- !u!114 &4287412615444322940
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7c7fcd37765e46e2b5a24bd2652ca069, type: 3}
  m_Name: Agressivity
  m_EditorClassIdentifier: Assembly-CSharp::Dialogues.DialogueNode
  speaker: {fileID: 11400000, guid: a16b1aa75a9227743a738bb8fc595bf2, type: 2}
  text: "C'est parce qu'il n'est pas pr\xEAt. C'est aussi simple que \xE7a."
  nextNode: {fileID: -8973589388903960247}
  position: {x: 3444, y: 344}
  choices: []
  enterEffects: []
  references:
    version: 2
    RefIds: []
--- !u!114 &4548739437749643691
