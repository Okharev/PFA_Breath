  m_Name: Serenity
  m_EditorClassIdentifier: Assembly-CSharp::Dialogues.DialogueNode
  speaker: {fileID: 11400000, guid: b7f3cfd0c7b90b844b1a440812b055a7, type: 2}
  text: "S'oublier pour les autres, c'est finir par dispara\xEEtre... Tu n'as plus
    \xE0 le faire\u2026 Tu n'as jamais eu \xE0 le faire."
  nextNode: {fileID: -3907467926077003685}
  position: {x: 8652, y: 1152}
  choices: []
  enterEffects: []
