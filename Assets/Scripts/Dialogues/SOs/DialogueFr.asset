  m_EditorClassIdentifier: Assembly-CSharp::Dialogues.DialogueNode
  speaker: {fileID: 11400000, guid: a16b1aa75a9227743a738bb8fc595bf2, type: 2}
  text: "Il est juste pas \xE0 la hauteur, j'dis \xE7a j'dis rien."
