  m_EditorClassIdentifier: Assembly-CSharp::Dialogues.DialogueNode
  speaker: {fileID: 11400000, guid: ebc351b868b44c14cb175d1c4ca66aea, type: 2}
  text: "Ah !  Quel empot\xE9  ! (toujours un simplet)"
  nextNode: {fileID: 0}
  position: {x: 1564, y: 296}
  choices:
  - choiceText: "Ouais ! Un vrai cr\xE9tin !"
    nextNode: {fileID: -7352791820482004563}
    conditions: []
    choiceEffects: []
  - choiceText: "C'est pas le couteau le plus aiguis\xE9 du tiroir\u2026"
    nextNode: {fileID: -7352791820482004563}
    conditions: []
    choiceEffects: []
  - choiceText: "Peut-\xEAtre, le paysage \xE9tait vraiment beau\u2026"
    nextNode: {fileID: -7352791820482004563}
    conditions: []
    choiceEffects: []
  enterEffects: []
  references:
    version: 2
    RefIds: []
