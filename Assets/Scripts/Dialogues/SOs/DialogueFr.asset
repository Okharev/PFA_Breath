  m_EditorClassIdentifier: Assembly-CSharp::Dialogues.DialogueNode
  speaker: {fileID: 11400000, guid: 05d8191cc2e06d44bb2a85359d8959a1, type: 2}
  text: "Le souvenir en question est\u2026 r\xE9sistant. Plus on se rapproche, plus
    \xE7a nous file entre les doigts\u2026"
  nextNode: {fileID: 4287412615444322940}
  position: {x: 3081, y: 325}
