.root-container {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 50px;
}

.speakers-container {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
    height: 1000px;
    margin-bottom: -40px;
}

.speaker-portrait {
    width: 600px;
    height: 600px;
    margin: 0 -20px;
    border-radius: 15px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale, opacity, translate;
    transition-duration: 0.3s, 0.3s, 0.5s;
    transition-timing-function: ease-in-out, ease-in-out, ease-out-back;
    margin-right: -100px;
    margin-left: -100px;
    margin-bottom: 0;
}

.speaker-hidden {
    scale: 0.5 0.5;
    opacity: 0;
    translate: -80px 0;
}

.speaker-active {
    scale: 1.15 1.15;
    opacity: 1;
    translate: 0 0;
}

.speaker-inactive {
    scale: 0.85 0.85;
    opacity: 0.4;
    translate: 0 0;
}

.dialogue-box,
.choices-box {
    width: 90%;
    max-width: 1920px;
    background-color: rgba(15, 15, 15, 0.95);
    border-radius: 12px;
    padding: 25px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
    background-image: url("project://database/Assets/Scripts/UI/UI_2D/Dialogue/dialogueBG.png?fileID=2800000&guid=eb9c93761e225df4bb3dfb2a79afd326&type=3#dialogueBG");
    max-height: 1080px;
    height: 20%;
}

.speaker-name {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(230, 180, 80);
    margin-bottom: 10px;
    width: 15%;
    align-self: auto;
    align-items: center;
}

.dialogue-text-container {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 20px;
}

.dialogue-word {
    font-size: 20px;
    color: rgb(240, 240, 240);
    margin-right: 6px;
    margin-bottom: 4px;
}

.next-button {
    align-self: flex-end;
    width: 120px;
    padding: 12px;
    background-color: rgb(40, 40, 40);
    color: white;
    font-size: 16px;
    border-radius: 6px;
    border-width: 0;
    transition-duration: 0.1s;
}

.next-button:hover {
    background-color: rgb(70, 70, 70);
}

.choices-box {
    flex-direction: column;
    justify-content: center;
}

.choice-button {
    margin-top: 8px;
    padding: 15px;
    background-color: rgb(35, 35, 35);
    color: white;
    font-size: 18px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    white-space: normal;
}

.choice-button:hover {
    background-color: rgb(60, 60, 60);
    border-color: rgba(255, 255, 255, 0.5);
}
