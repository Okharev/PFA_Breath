{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "b4c669ade61149669e3a9c51b97c4d8e",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SynapseSDF (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -394.4000244140625,
            "y": 183.20001220703126,
            "width": 228.0,
            "height": 76.79998779296875
        }
    },
    "m_Slots": [
        {
            "m_Id": "3145812726d249179185b8d15b96b43a"
        },
        {
            "m_Id": "aee4d9d79efa4cb6b65044424acce9ee"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SynapseSDF",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// 1. Convert UVs to pure Pixel Coordinates to prevent Aspect Ratio stretching\r\nfloat2 pixelPos = UV * _RectSize;\r\n\r\n// 2. Vector Math for Line Segment Distance\r\nfloat2 ba = _PointB - _PointA;\r\nfloat2 pa = pixelPos - _PointA;\r\nfloat h = saturate(dot(pa, ba) / dot(ba, ba));\r\nfloat distToLine = length(pa - ba * h);\r\n\r\n// 3. Distance Traveled along the line\r\nfloat totalDist = length(ba);\r\nfloat d1 = h * totalDist;\r\nfloat d2 = (1.0 - h) * totalDist;\r\n\r\n// 4. Physical Tapering Logic (Quadratic Ease-In)\r\nfloat stretch = 1.2; // How far the membrane stretches outside the node\r\nfloat factor1 = saturate(1.0 - (d1 / ((_StartRadius * 0.5) * stretch)));\r\nfloat factor2 = saturate(1.0 - (d2 / ((_EndRadius * 0.5) * stretch)));\r\n\r\nfloat ease1 = factor1 * factor1;\r\nfloat ease2 = factor2 * factor2;\r\n\r\n// 5. Calculate Dynamic Radii\r\nfloat minGlow = 8.0;\r\nfloat minCore = 3.0;\r\n\r\nfloat currentGlowRadius = minGlow + ((_StartRadius * 0.5) * ease1) + ((_EndRadius * 0.5) * ease2);\r\nfloat currentCoreRadius = minCore + ((_StartRadius * 0.25) * ease1) + ((_EndRadius * 0.25) * ease2);\r\n\r\n// 6. Smoothstep Anti-Aliasing (Blends the edge over 1.5 pixels)\r\nfloat blur = 1.5;\r\nfloat glowAlpha = smoothstep(currentGlowRadius + blur, currentGlowRadius - blur, distToLine);\r\nfloat coreAlpha = smoothstep(currentCoreRadius + blur, currentCoreRadius - blur, distToLine);\r\n\r\n// 7. Composite the Colors\r\nfloat4 finalColor = lerp(float4(0,0,0,0), _GlowColor, glowAlpha);\r\nfinalColor = lerp(finalColor, _CoreColor, coreAlpha);\r\n\r\nOutColor = finalColor;"
}

