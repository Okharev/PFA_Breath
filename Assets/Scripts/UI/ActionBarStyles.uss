/* 1. Root Container: Now just an invisible fullscreen canvas */
.screen-container {
    width: 100%;
    height: 100%;
    position: absolute; /* Ensures it covers the screen for corner calculation */
    overflow: hidden;
}

/* 2. The ArcHudPanel itself handles its bounds automatically */
.arc-hud-panel {
    position: absolute;
    width: 100%;
    height: 100%;
}

/* 3. Refactored Slot Styles (Replaces .ability-slot) */
.spell-slot {
    /* --- STRUCTURAL OVERRIDES FOR ARC PLACEMENT --- */
    position: absolute;
    translate: -50% -50%; /* CRITICAL: Math calculates center, not top-left pivot */

    /* --- YOUR EXISTING MMO VISUALS --- */
    width: 64px;
    height: 64px;
    background-color: #1e1e1e;
    border-radius: 6px;
    border-width: 2px;
    border-color: #555;
    align-items: center;
    justify-content: center;
    transition-property: opacity, border-color, scale;
    transition-duration: 0.2s;
}

/* Keep your existing cooldown states and text styling */
.spell-slot.ability-on-cooldown {
    opacity: 0.4;
    border-color: #e24a4a;
}

/* Hover effect for polish */
.spell-slot:hover {
    scale: 1.1;
    border-color: #f39c12;
}

.hotkey-text {
    position: absolute;
    top: 2px;
    left: 4px;
    color: #f39c12;
    font-size: 14px;
    -unity-font-style: bold;
}

.ability-text {
    color: white;
    font-size: 10px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.cooldown-text {
    position: absolute;
    color: white;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 0px black;
}

/* Channel bar overlays the bottom of the icon */
.channel-progress {
    position: absolute;
    bottom: -15px;
    width: 100%;
    height: 10px;
    background-color: #f39c12; /* Added a color so it's visible */
}