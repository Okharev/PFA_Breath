    },
    "m_Name": "NeuralSDF (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -895.9998779296875,
            "y": 180.8000030517578,
            "width": 215.99993896484376,
            "height": 357.5999755859375
        }
    },
    "m_Slots": [
        {
            "m_Id": "249fe914a59f45ff813061bb31dcc929"
        },
        {
            "m_Id": "65fdf70c5a0342d3aa9dd7b0bdbef912"
        },
        {
            "m_Id": "38a719b235524d9babf7600fd33b7098"
        },
        {
            "m_Id": "b88735e1cbe74b1f844a0769d48139f6"
        },
        {
            "m_Id": "47e4b36af4ec4325bff365453c54a3f3"
        },
        {
            "m_Id": "b8c68c20e0a34e3a8b7648a4f89f0a3a"
        },
        {
            "m_Id": "863ea2cd00dc4a879ef62fb845d7edeb"
        },
        {
            "m_Id": "132c57e4d75b47328fe0023306c9b2a0"
        },
        {
            "m_Id": "3627aaa716624763974f27744372e78d"
        },
        {
            "m_Id": "bce72f82d3e74473ad41ad289cef117d"
        },
        {
            "m_Id": "37f6899170ea4a409797b2792bfc3e1a"
        },
        {
            "m_Id": "34837784fa384d2ba8c24b199f82138c"
        },
        {
            "m_Id": "d1173e1384a149159734300920960281"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "NeuralSDF",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// 1. Pack inputs into a local array\r\nfloat2 positions[8];\r\npositions[0] = Node0.xy;\r\npositions[1] = Node1.xy;\r\npositions[2] = Node2.xy;\r\npositions[3] = Node3.xy;\r\npositions[4] = Node4.xy;\r\npositions[5] = Node5.xy;\r\npositions[6] = Node6.xy;\r\npositions[7] = Node7.xy;\r\n\r\nfloat finalDist = 1000.0; \r\nint count = min((int)NodeCount, 8); // Safety clamp\r\n\r\nif (count < 2) {\r\n    Distance = 1000.0;\r\n    return;\r\n}\r\n\r\n// Protect against division by zero in the smoothing math\r\nfloat k = max(Smoothness, 0.0001);\r\n\r\n// 2. Calculate distances iteratively\r\nfor (int i = 0; i < count - 1; i++) {\r\n    float2 p1 = positions[i];\r\n    float2 p2 = positions[i+1];\r\n    \r\n    // --- A. Distance to Line Segment ---\r\n    float2 pa = UV - p1;\r\n    float2 ba = p2 - p1;\r\n    // clamp and protect against zero-length lines\r\n    float line_h = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0);\r\n    float lineDist = length(pa - ba * line_h) - Thickness;\r\n    \r\n    // --- B. Smooth Minimum (Blend Line with Final Dist) ---\r\n    float sm_h1 = clamp(0.5 + 0.5 * (lineDist - finalDist) / k, 0.0, 1.0);\r\n    finalDist = lerp(lineDist, finalDist, sm_h1) - k * sm_h1 * (1.0 - sm_h1);\r\n    \r\n    // --- C. Distance to Node Bulb ---\r\n    float nodeDist = length(UV - p1) - (Thickness * 2.0);\r\n    \r\n    // --- D. Smooth Minimum (Blend Node Bulb with Final Dist) ---\r\n    float sm_h2 = clamp(0.5 + 0.5 * (nodeDist - finalDist) / k, 0.0, 1.0);\r\n    finalDist = lerp(nodeDist, finalDist, sm_h2) - k * sm_h2 * (1.0 - sm_h2);\r\n}\r\n\r\n// --- E. Blend the final Node Bulb ---\r\nfloat lastNodeDist = length(UV - positions[count - 1]) - (Thickness * 2.0);\r\nfloat sm_h3 = clamp(0.5 + 0.5 * (lastNodeDist - finalDist) / k, 0.0, 1.0);\r\nfinalDist = lerp(lastNodeDist, finalDist, sm_h3) - k * sm_h3 * (1.0 - sm_h3);\r\n\r\nDistance = finalDist;"
}

