/* 1. Root Container: Now just an invisible fullscreen canvas */
.screen-container {
    width: 100%;
    height: 100%;
    position: absolute; /* Ensures it covers the screen for corner calculation */
    overflow: hidden;
}

/* --- PLAYER STATS BARS --- */
.player-stats-container {
    position: absolute;
    top: 20px;
    left: 20px;
    width: 250px;
    flex-direction: column;
}

.stat-bar-bg {
    height: 18px;
    background-color: rgba(30, 30, 30, 0.8);
    border-radius: 4px;
    border-width: 2px;
    border-color: #555;
    margin-bottom: 8px;
    overflow: hidden; /* Ensures the fill doesn't bleed outside the rounded corners */
}

.stat-bar-fill {
    height: 100%;
    width: 100%; /* Will be dynamically scaled via C# */
    transition-property: width;
    transition-duration: 0.25s; /* Smooth hardware-accelerated animation */
    transition-timing-function: ease-out-cubic;
}

.health-color {
    background-color: #e24a4a; /* Matches your cooldown border red */
}

.oxygen-color {
    background-color: #3498db;
}

/* 2. The ArcHudPanel itself handles its bounds automatically */
.arc-hud-panel {
    position: absolute;
    width: 100%;
    height: 100%;
}

.spell-slot {
    position: absolute;
    width: 60px;
    height: 60px;
    background-color: rgba(30, 30, 30, 0.8);

    /* 1. Changed to 50% to make the UI slot a perfect circle */
    border-radius: 50%;
    border-width: 2px;
    border-color: #A0A0A0;

    /* Offsets the pivot from Top-Left to the Center */
    translate: -50% -50%;

    /* Smooth transitions for hover and cooldown tinting */
    transition-property: scale, translate, border-color, -unity-background-image-tint-color;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;

    /* 2. Ensures the ability icon scales properly inside the circular slot */
    -unity-background-scale-mode: scale-to-fit;
}

/* Keep your existing cooldown states and text styling */
.spell-slot.ability-on-cooldown {
    border-color: #555555;
    /* Darkens the assigned ability icon to indicate it is unavailable */
    -unity-background-image-tint-color: rgb(80, 80, 80);
}

/* Hover effect for polish */
.spell-slot:hover {
    scale: 1.15;
    background-color: rgba(60, 60, 60, 0.9);
    border-color: #FFFFFF;
    translate: -50% -15px;
}

.hotkey-text {
    position: absolute;
    bottom: -22px; /* Pulls it entirely outside the circle */
    width: 100%;
    -unity-text-align: middle-center;
    color: #ffaa00;
    font-size: 14px;
    -unity-font-style: bold;
}

.ammo-display {
    position: absolute;

    /* 1. Equalize width and height to form a perfect square foundation */
    width: 80px;
    height: 80px;

    /* 2. White background to simulate the sphere */
    background-color: #FFFFFF;

    /* 3. 50% border-radius turns the square into a perfect circle */
    border-radius: 50%;

    /* 4. A slight gray border gives it a subtle 3D edge/volume */
    border-width: 4px;
    border-color: #E0E0E0;

    /* Crucial: Centers the pivot */
    translate: -50% -50%;

    align-items: center;
    justify-content: center;

    /* Optional: Add a subtle shadow for depth */
    box-shadow: 2px 4px 10px rgba(0, 0, 0, 0.5);
}

.ammo-display > #ammo-text {
    /* Contrast inversion: Dark text on the white background */
    color: #1A1A1A;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ability-text {
    color: white;
    font-size: 10px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.cooldown-text {
    position: absolute;
    width: 100%;
    height: 100%;
    color: #ffffff;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    /* Adds a harsh shadow to ensure the text pops regardless of the icon's color */
    text-shadow: 2px 2px 0px rgba(0,0,0,0.9);
}

/* Channel bar overlays the bottom of the icon */
.channel-progress {
    position: absolute;
    bottom: -15px;
    width: 100%;
    height: 10px;
    background-color: #f39c12; /* Added a color so it's visible */
}