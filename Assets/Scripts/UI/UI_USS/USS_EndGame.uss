:root {
}

.Button {
    font-size: 45px;
    width: 350px;
    height: 140px;
    -unity-font-definition: url("project://database/Assets/Scripts/UI/UI_2D/Aharoni/ahronbd.ttf?fileID=12800000&guid=6fd4b862a7d761c439c8aca702c2ae14&type=3#ahronbd");
    color: rgb(255, 250, 250);
    background-image: url("project://database/Assets/Scripts/UI/UI_2D/Ui_MainMenu/Main%20menu/Mainmenu_button.png?fileID=2800000&guid=82ed56c64075b64449215029ea44e3d0&type=3#Mainmenu_button");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
}

.Button:hover {
    transition-property: scale;
    transition-duration: 0.2s;
    width: 360px;
    height: 150px;
}
