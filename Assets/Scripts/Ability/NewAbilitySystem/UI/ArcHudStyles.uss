/* ArcHudStyles.uss */

.arc-hud-panel {
    /* Anchors the panel to a specific size, typically expanding to fill the container 
       so the corner calculations align with the screen edges. */
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

/* 1. ROOT PIVOT: Handles positioning and the inward translate animation */
.spell-slot {
    position: absolute;
    width: 60px;
    height: 60px;
    /* Keeps the slot perfectly centered on your math coordinates */
    translate: -50% -50%;
    transition-property: translate;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
}

.ability-icon {
    position: absolute;
    width: 100%;
    height: 100%;

    /* Graphics Optimization: Forces the sprite to fit cleanly within the generated quad's UVs */
    -unity-background-scale-mode: scale-to-fit;

    /* Keeps the image tucked cleanly inside the visual container's rounded borders */
    border-radius: 10px;
}\

/* The physical pivot still moves inward along its rotated local Y-axis */
.spell-slot:hover, .spell-slot.selected {
    translate: -50% -15px;
}

/* 2. VISUAL CONTAINER: Handles the upright look, colors, borders, and scaling */
.spell-slot-visual {
    width: 100%;
    height: 100%;
    background-color: rgba(30, 30, 30, 0.8);
    border-radius: 12px;
    border-width: 2px;
    border-color: #A0A0A0;

    transition-property: scale, background-color, border-color;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
}

/* Route the root's hover/selected states to trigger visual changes on the upright child */
.spell-slot:hover .spell-slot-visual {
    scale: 1.15;
    background-color: rgba(60, 60, 60, 0.9);
    border-color: #FFFFFF;
}

.spell-slot.selected .spell-slot-visual {
    scale: 1.15;
    border-color: #f39c12;
}

.ammo-display {
    position: absolute;
    width: 120px;
    height: 50px;
    background-color: rgba(10, 10, 10, 0.9);
    border-radius: 25px;
    border-width: 2px;
    border-color: #ffaa00;

    /* Crucial: Centers the pivot */
    translate: -50% -50%;

    align-items: center;
    justify-content: center;
}

.ammo-display > #ammo-text {
    color: #ffaa00;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.skip-turn-button {
    position: absolute;
    /* ... existing properties ... */

    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #FFFFFF;

    /* ADD THESE TWO LINES: Forces strict geometric centering in the background quad */
    -unity-background-position-x: center;
    -unity-background-position-y: center;

    transition-property: scale, background-color, border-color;

    width: 60px;
    height: 60px;
    border-radius: 30px;
    overflow: hidden;
    
    justify-content: center;

    background-color: rgba(10, 10, 10, 0.9);
    border-width: 2px;
    border-color: #ffaa00;

    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #FFFFFF;

    transition-property: scale, background-color, border-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-back;
}

.skip-turn-button:hover {
    scale: 1.15;
    background-color: rgba(30, 30, 30, 0.9);
    border-color: #FFFFFF;
}

.skip-turn-button:active {
    scale: 0.95;
    background-color: rgba(0, 0, 0, 0.9);
    border-color: #ffaa00;
}