/* ArcHudStyles.uss */

.arc-hud-panel {
    /* Anchors the panel to a specific size, typically expanding to fill the container 
       so the corner calculations align with the screen edges. */
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.spell-slot {
    position: absolute;
    width: 60px;
    height: 60px;
    background-color: rgba(30, 30, 30, 0.8);
    border-radius: 12px;
    border-width: 2px;
    border-color: #A0A0A0;

    /* Crucial: Offsets the pivot from Top-Left to the Center of the element.
       This ensures polar coordinate math perfectly centers the element on the arc line. */
    translate: -50% -50%;

    /* Smooth transitions for hover effects */
    transition-property: scale, translate, border-color; /* Add translate to transitions */
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back; /* Gives it a nice snappy feel */
}

.spell-slot:hover {
    scale: 1.15;
    background-color: rgba(60, 60, 60, 0.9);
    border-color: #FFFFFF;
}

.spell-slot:hover, .spell-slot.selected {
    scale: 1.15;
    border-color: #f39c12;

    /* Because the element is rotated tangentially to the arc, 
      moving it -15px on the Y axis slides it perfectly inward 
      toward the screen center, pulling it away from the circle border. 
      Note: We keep the -50% X translation so it stays centered on its line!
    */
    translate: -50% -15px;
}

.ammo-display {
    position: absolute;
    width: 120px;
    height: 50px;
    background-color: rgba(10, 10, 10, 0.9);
    border-radius: 25px;
    border-width: 2px;
    border-color: #ffaa00;

    /* Crucial: Centers the pivot */
    translate: -50% -50%;

    align-items: center;
    justify-content: center;
}

.ammo-display > #ammo-text {
    color: #ffaa00;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.skip-turn-button {
    /* Set equal dimensions for a perfect circle */
    width: 50px;
    height: 50px;
    /* 50% of the width/height creates a mathematically perfect circle */
    border-radius: 25px;

    /* Clean, semi-transparent white base */
    background-color: rgba(255, 255, 255, 0.85);
    border-width: 2px;
    border-color: #FFFFFF;

    /* Dark text for high contrast against the white background */
    color: #1a1a1a;
    -unity-font-style: bold;
    font-size: 12px;
    -unity-text-align: middle-center;

    transition-property: scale, background-color, border-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-back;
}

.skip-turn-button:hover {
    scale: 1.15;
    /* Solidify the white and add an orange border to visually tie it to the Ammo Display */
    background-color: #FFFFFF;
    border-color: #ffaa00;
}

.skip-turn-button:active {
    scale: 0.95;
    /* Slightly darken the white to simulate a physical press */
    background-color: #e0e0e0;
    border-color: #FFFFFF;
}
