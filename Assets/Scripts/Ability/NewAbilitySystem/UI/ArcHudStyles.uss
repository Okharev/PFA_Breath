/* ArcHudStyles.uss */

.arc-hud-panel {
    /* Anchors the panel to a specific size, typically expanding to fill the container 
       so the corner calculations align with the screen edges. */
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.spell-slot {
    position: absolute;
    width: 60px;
    height: 60px;
    background-color: rgba(30, 30, 30, 0.8);
    border-radius: 12px;
    border-width: 2px;
    border-color: #A0A0A0;

    /* Crucial: Offsets the pivot from Top-Left to the Center of the element.
       This ensures polar coordinate math perfectly centers the element on the arc line. */
    translate: -50% -50%;

    /* Smooth transitions for hover effects */
    transition-property: scale, translate, border-color; /* Add translate to transitions */
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back; /* Gives it a nice snappy feel */
}

.spell-slot:hover {
    scale: 1.15;
    background-color: rgba(60, 60, 60, 0.9);
    border-color: #FFFFFF;
}

.spell-slot:hover, .spell-slot.selected {
    scale: 1.15;
    border-color: #f39c12;

    /* Because the element is rotated tangentially to the arc, 
      moving it -15px on the Y axis slides it perfectly inward 
      toward the screen center, pulling it away from the circle border. 
      Note: We keep the -50% X translation so it stays centered on its line!
    */
    translate: -50% -15px;
}

.ammo-display {
    position: absolute;
    width: 120px;
    height: 50px;
    background-color: rgba(10, 10, 10, 0.9);
    border-radius: 25px;
    border-width: 2px;
    border-color: #ffaa00;

    /* Crucial: Centers the pivot */
    translate: -50% -50%;

    align-items: center;
    justify-content: center;
}

.ammo-display > #ammo-text {
    color: #ffaa00;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.spell-slot.stacked-active {
    scale: 1;
    /* Keeps it perfectly centered on the mathematical node */
    translate: -50% -50%;
    opacity: 1;
    -unity-background-image-tint-color: #FFFFFF;
}

.spell-slot.stacked-inactive {
    /* Shrink the inactive ability */
    scale: 0.65;

    /* Offsets the pivot. Because the element is rotated toward the corner, 
       this pushes it deeper into the screen corner and slightly sideways so it peeks out.
       Tweak these percentages to change which direction it peeks! */
    translate: -20% -80%;

    /* Darken and fade */
    -unity-background-image-tint-color: rgb(80, 80, 80);
    opacity: 0.85;
}

/* Disable hover effects for the inactive weapon in the stack */
.spell-slot.stacked-inactive:hover {
    scale: 0.65;
    translate: -20% -80%;
    border-color: #A0A0A0;
}

/* Hide the hotkey text for the inactive ability to prevent visual clutter */
.spell-slot.stacked-inactive .hotkey-text {
    display: none;
}