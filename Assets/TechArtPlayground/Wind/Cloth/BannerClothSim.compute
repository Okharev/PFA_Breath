#pragma kernel CSPredict
#pragma kernel CSSolveConstraints
#pragma kernel CSIntegrate
#pragma kernel CSComputeNormals

#pragma kernel CSHashParticles
#pragma kernel CSClearCellOffsets
#pragma kernel CSBuildCellOffsets
#pragma kernel CSSolveSelfCollisions

// ==========================================
// --- STRUCTURE OF ARRAYS (SoA) BUFFERS ---
// ==========================================
RWStructuredBuffer<float3> Positions;
RWStructuredBuffer<float3> PredictedPositions;
RWStructuredBuffer<float3> Normals;
StructuredBuffer<float2> UVs;

struct ClothCollider
{
    int type; float radius; float2 padding1;
    float3 posA; float padding2;
    float3 posB; float padding3;
    float4x4 worldToLocal; float4x4 localToWorld;
    float3 extents; float padding4;
};
StructuredBuffer<ClothCollider> Colliders;

struct PhysicsState
{
    float3 velocity;
    float inverseMass;
    uint colliderStart;
    uint colliderCount;
    float selfCollideMask;
    float padding;
};
RWStructuredBuffer<PhysicsState> PhysicsData;

struct SpringLink { uint startIndex; uint count; };
StructuredBuffer<SpringLink> SpringLinks;

struct Spring
{
    uint targetIndex;
    float restLength;
    float compliance;
    float padding;
};
StructuredBuffer<Spring> Springs;

// Lock-Free Normal Generation
// x=left, y=right, z=top, w=bottom (Indices). -1 means no neighbor.
StructuredBuffer<int4> Adjacency;

// Uniforms
uint _VertexCount;
float _DeltaTime;
float _Time;
float3 _Gravity;
float3 _WindVelocity;
float _WindTurbulence;
float _Drag;

// --- NEW UNIFORMS & BUFFERS ---
uint _HashGridSize;
float _CellSize;
float _SelfCollisionThickness;

struct ParticleHashPair 
{ 
    uint particleIndex; 
    uint cellHash; 
};

RWStructuredBuffer<ParticleHashPair> HashPairs;
StructuredBuffer<ParticleHashPair> SortedHashPairs;
RWStructuredBuffer<uint> CellOffsets;


// --- SPATIAL HASHING MATH ---
uint Hash(int3 cell) 
{
    // Replaced % _HashGridSize with & (_HashGridSize - 1)
    // This ONLY works because 131072 is a power of two!
    return ((uint)(cell.x * 73856093) ^ (uint)(cell.y * 19349663) ^ (uint)(cell.z * 83492791)) & (_HashGridSize - 1);
}

[numthreads(64, 1, 1)]
void CSHashParticles(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _VertexCount) return;

    // OPTIMIZATION: Build the grid based on current Positions, not Predictions
    float3 pos = Positions[id.x]; 
    int3 cell = floor(pos / _CellSize);
    
    ParticleHashPair pair;
    pair.particleIndex = id.x;
    pair.cellHash = Hash(cell);
    
    HashPairs[id.x] = pair;
}
[numthreads(64, 1, 1)]
void CSClearCellOffsets(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _HashGridSize) return;
    CellOffsets[id.x] = 0xFFFFFFFF;
}

[numthreads(64, 1, 1)]
void CSBuildCellOffsets(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _VertexCount) return;

    uint hash = SortedHashPairs[id.x].cellHash;
    uint prevHash = 0xFFFFFFFF;
    
    // SAFELY check previous array index without out-of-bounds read
    if (id.x > 0) 
    {
        prevHash = SortedHashPairs[id.x - 1].cellHash;
    }
    
    if (hash != prevHash)
    {
        CellOffsets[hash] = id.x;
    }
}

[numthreads(64, 1, 1)]
void CSSolveSelfCollisions(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _VertexCount) return;

    PhysicsState p = PhysicsData[id.x];
    if (p.inverseMass <= 0.0f || p.selfCollideMask <= 0.0f) return;

    // The current predicted position we want to push away from neighbors
    float3 pos = PredictedPositions[id.x];
    
    // OPTIMIZATION: Find our query center using the exact same Positions 
    // array we built the static grid with at the start of the frame!
    int3 cell = floor(Positions[id.x] / _CellSize);
    
    float3 posDelta = float3(0, 0, 0);
    float weightCount = 0.0f;
    float thickSq = _SelfCollisionThickness * _SelfCollisionThickness;

    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            for (int z = -1; z <= 1; z++) {
                
                uint hash = Hash(cell + int3(x, y, z));
                uint startIndex = CellOffsets[hash];
                
                if (startIndex == 0xFFFFFFFF) continue;

                for (uint i = startIndex; i < _VertexCount; i++) 
                {
                    ParticleHashPair neighborPair = SortedHashPairs[i];
                    if (neighborPair.cellHash != hash) break; 
                    if (neighborPair.particleIndex == id.x) continue;
                    
                    // Penetrations are resolved using the active PredictedPositions
                    float3 neighborPos = PredictedPositions[neighborPair.particleIndex];
                    float3 dir = pos - neighborPos;
                    float distSq = dot(dir, dir);

                    if (distSq > 0.000001f && distSq < thickSq) 
                    {
                        float dist = sqrt(distSq);
                        float3 normal = dir / dist;
                        float penetration = _SelfCollisionThickness - dist;

                        float neighborInvMass = PhysicsData[neighborPair.particleIndex].inverseMass;
                        float invMassSum = p.inverseMass + neighborInvMass;
                        
                        if (invMassSum > 0.0f) 
                        {
                            float w = p.inverseMass / invMassSum;
                            posDelta += normal * penetration * w;
                            weightCount += 1.0f;
                        }
                    }
                }
            }
        }
    }

    if (weightCount > 0.0f)
    {
        PredictedPositions[id.x] += posDelta / weightCount;
    }
}

// ==========================================
// --- 1. PREDICT POSITIONS & WIND ---
// ==========================================
[numthreads(64, 1, 1)]
void CSPredict(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _VertexCount) return;

    PhysicsState p = PhysicsData[id.x];
    if (p.inverseMass <= 0.0f) 
    {
        PredictedPositions[id.x] = Positions[id.x];
        return;
    }

    float3 force = _Gravity;

    float windMag = length(_WindVelocity);
    if (windMag > 0.001f)
    {
        float noise = sin(_Time * 8.0f + Positions[id.x].x * 4.0f + Positions[id.x].y * 4.0f) * _WindTurbulence;
        float3 actualWind = _WindVelocity * (1.0f + noise);
        
        float3 normal = Normals[id.x];
        float3 windDir = actualWind / length(actualWind);
        
        float windExposure = abs(dot(windDir, normal));
        float aeroMultiplier = 1.0f;

        force += actualWind * (0.1f + windExposure * 0.9f) * aeroMultiplier;
    }

    p.velocity += force * p.inverseMass * _DeltaTime;
    PredictedPositions[id.x] = Positions[id.x] + p.velocity * _DeltaTime;
    
    PhysicsData[id.x] = p;
}

// ==========================================
// --- 2. SOLVE CONSTRAINTS (STIFF XPBD) ---
// ==========================================
[numthreads(64, 1, 1)]
void CSSolveConstraints(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _VertexCount) return;

    PhysicsState p = PhysicsData[id.x];
    if (p.inverseMass <= 0.0f) return;

    float3 currentPos = PredictedPositions[id.x];
    SpringLink link = SpringLinks[id.x];

    float3 posDelta = float3(0,0,0);
    float weightCount = 0.0f;
    float omega = 1.0f;

    for (uint i = 0; i < link.count; i++)
    {
        Spring spring = Springs[link.startIndex + i];

        float3 neighborPos = PredictedPositions[spring.targetIndex];
        float neighborInvMass = PhysicsData[spring.targetIndex].inverseMass;

        float3 deltaP = currentPos - neighborPos;
        float dist = length(deltaP);

        if (dist > 0.0001f)
        {
            float3 dir = deltaP / dist;
            float constraint = dist - spring.restLength;
            
            float invMassSum = p.inverseMass + neighborInvMass;

            if (invMassSum > 0.0f)
            {
                float alphaTilde = spring.compliance / (_DeltaTime * _DeltaTime);
                float lambda = -constraint / (invMassSum + alphaTilde);
                
                posDelta += p.inverseMass * lambda * dir * omega;
                weightCount += 1.0f;
            }
        }
    }
    
    if (weightCount > 0.0f)
    {
        PredictedPositions[id.x] += posDelta / weightCount;
    }

    // --- STATIC COLLISIONS (XPBD Positional Push) ---
    for (uint c = 0; c < p.colliderCount; c++)
    {
        ClothCollider col = Colliders[p.colliderStart + c];
        float3 normal = float3(0, 0, 0);
        float penetration = 0;
        
        float3 pos = PredictedPositions[id.x];

        if (col.type == 0) // Sphere
        {
            float3 dir = pos - col.posA;
            float dist = max(length(dir), 0.0001f);
            if (dist < col.radius) { normal = dir / dist; penetration = col.radius - dist; }
        }
        else if (col.type == 1) // Capsule
        {
            float3 ab = col.posB - col.posA;
            float t = saturate(dot(pos - col.posA, ab) / max(dot(ab, ab), 0.0001f));
            float3 closest = col.posA + t * ab;

            float3 dir = pos - closest;
            float dist = max(length(dir), 0.0001f);

            if (dist < col.radius) { normal = dir / dist; penetration = col.radius - dist; }
        }
        else if (col.type == 2) // Box
        {
            float3 localPos = mul(col.worldToLocal, float4(pos, 1.0)).xyz;
            float3 d = abs(localPos) - col.extents;
            float dist = length(max(d, 0.0)) + min(max(d.x, max(d.y, d.z)), 0.0);

            if (dist < 0.0) 
            {
                float3 normalLocal = float3(0,0,0);

                if (d.x > d.y && d.x > d.z) normalLocal = float3(sign(localPos.x), 0, 0);
                else if (d.y > d.z) normalLocal = float3(0, sign(localPos.y), 0);
                else normalLocal = float3(0, 0, sign(localPos.z));

                normal = normalize(mul((float3x3)col.localToWorld, normalLocal));
                penetration = -dist;
            }
        }

        if (penetration > 0.0)
        {
            PredictedPositions[id.x] += normal * penetration;
        }
    }
}

struct VertexTriLink { uint startIndex; uint count; };
StructuredBuffer<int3> Triangles;
StructuredBuffer<VertexTriLink> VertexTriLinks;
StructuredBuffer<int> VertexTriIndices;

// ==========================================
// --- 3. INTEGRATE (UPDATE VELOCITY) ---
// ==========================================
[numthreads(64, 1, 1)]
void CSIntegrate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _VertexCount) return;

    PhysicsState p = PhysicsData[id.x];
    if (p.inverseMass > 0.0f)
    {
        float3 newVelocity = (PredictedPositions[id.x] - Positions[id.x]) / _DeltaTime;
        
        // Topology-Agnostic Velocity Smoothing
        float3 avgVel = newVelocity;
        float count = 1.0f;
        
        SpringLink link = SpringLinks[id.x];
        for(uint i = 0; i < link.count; i++)
        {
            Spring spring = Springs[link.startIndex + i];
            avgVel += PhysicsData[spring.targetIndex].velocity;
            count += 1.0f;
        }

        avgVel /= count;
        newVelocity = lerp(newVelocity, avgVel, 0.1f);

        float speed = length(newVelocity);
        newVelocity -= newVelocity * min(speed * _Drag * _DeltaTime, 1.0f);
        newVelocity *= exp(-_Drag * _DeltaTime);

        p.velocity = newVelocity;
        Positions[id.x] = PredictedPositions[id.x];
        PhysicsData[id.x] = p;
    }
}

// ==========================================
// --- 4. TOPOLOGY-AGNOSTIC NORMALS ---
// ==========================================
[numthreads(64, 1, 1)]
void CSComputeNormals(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _VertexCount) return;
    
    VertexTriLink link = VertexTriLinks[id.x];
    float3 accumulatedNormal = float3(0, 0, 0);

    // Loop through all triangles this vertex is a part of
    for(uint i = 0; i < link.count; i++)
    {
        int triIndex = VertexTriIndices[link.startIndex + i];
        int3 tri = Triangles[triIndex];
        
        float3 v0 = Positions[tri.x];
        float3 v1 = Positions[tri.y];
        float3 v2 = Positions[tri.z];
        
        // Compute Face Normal (Cross Product of edges)
        float3 faceNormal = cross(v1 - v0, v2 - v0);
        accumulatedNormal += faceNormal;
    }

    float len = length(accumulatedNormal);
    Normals[id.x] = (len > 0.0001f) ? (accumulatedNormal / len) : float3(0, 1, 0);
}