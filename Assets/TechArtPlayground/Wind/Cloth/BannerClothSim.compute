#pragma kernel CSPredict
#pragma kernel CSSolveConstraints
#pragma kernel CSIntegrate
#pragma kernel CSComputeNormals

// ==========================================
// --- STRUCTURE OF ARRAYS (SoA) BUFFERS ---
// ==========================================
RWStructuredBuffer<float3> Positions;
RWStructuredBuffer<float3> PredictedPositions;
RWStructuredBuffer<float3> Normals;
StructuredBuffer<float2> UVs;

struct ClothCollider
{
    int type; float radius; float2 padding1;
    float3 posA; float padding2;
    float3 posB; float padding3;
    float4x4 worldToLocal; float4x4 localToWorld;
    float3 extents; float padding4;
};
StructuredBuffer<ClothCollider> Colliders;

// Ensure your PhysicsState matches your C# struct again!
struct PhysicsState
{
    float3 velocity;
    float inverseMass;
    uint colliderStart;
    uint colliderCount;
    float selfCollideMask;
    float padding;
};

RWStructuredBuffer<PhysicsState> PhysicsData;

struct SpringLink { uint startIndex; uint count; };
StructuredBuffer<SpringLink> SpringLinks;

struct Spring
{
    uint targetIndex;
    float restLength;
    float compliance; // Inverse stiffness (alpha)
    float padding;
};
StructuredBuffer<Spring> Springs;

// Lock-Free Normal Generation
// x=left, y=right, z=top, w=bottom (Indices). -1 means no neighbor.
StructuredBuffer<int4> Adjacency;

// Uniforms
uint _VertexCount;
float _DeltaTime;
float _Time;
float3 _Gravity;
float3 _WindVelocity;
float _WindTurbulence;
float _Drag;

// ==========================================
// --- 1. PREDICT POSITIONS & WIND ---
// ==========================================
[numthreads(64, 1, 1)]
void CSPredict(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _VertexCount) return;
    
    PhysicsState p = PhysicsData[id.x];
    if (p.inverseMass <= 0.0f) 
    {
        PredictedPositions[id.x] = Positions[id.x];
        return;
    }

    float3 force = _Gravity;

    // --- AERODYNAMIC WIND ---
    float windMag = length(_WindVelocity);
    if (windMag > 0.001f)
    {
        // Add high-frequency spatial noise to simulate gusts/ripples
        float noise = sin(_Time * 8.0f + Positions[id.x].x * 4.0f + Positions[id.x].y * 4.0f) * _WindTurbulence;
        float3 actualWind = _WindVelocity * (1.0f + noise);
        
        // Calculate how much the cloth surface faces the wind
        float3 normal = Normals[id.x];
        float3 windDir = actualWind / length(actualWind);
        
        // Aerodynamic drag: wind pushes harder against flat surfaces
        float windExposure = abs(dot(windDir, normal));
        
        // Base aerodynamic multiplier (cranked up to fight gravity)
        float aeroMultiplier = 8.0f; 
        
        force += actualWind * (0.1f + windExposure * 0.9f) * aeroMultiplier;
    }

    // Explicit Euler Integration
    p.velocity += force * p.inverseMass * _DeltaTime;
    PredictedPositions[id.x] = Positions[id.x] + p.velocity * _DeltaTime;
    
    PhysicsData[id.x] = p;
}

// ==========================================
// --- 2. SOLVE CONSTRAINTS (STIFF XPBD) ---
// ==========================================
[numthreads(64, 1, 1)]
void CSSolveConstraints(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _VertexCount) return;
    
    PhysicsState p = PhysicsData[id.x];
    if (p.inverseMass <= 0.0f) return;

    float3 currentPos = PredictedPositions[id.x];
    SpringLink link = SpringLinks[id.x];

    float3 posDelta = float3(0,0,0);
    float weightCount = 0.0f;

    // Successive Over-Relaxation (SOR) parameter to fix Jacobi stretchiness.
    // 1.0 is standard (stretchy). 1.5 to 1.8 forces rapid stiffness.
    float omega = 1.6f; 

    for (uint i = 0; i < link.count; i++)
    {
        Spring spring = Springs[link.startIndex + i];
        float3 neighborPos = PredictedPositions[spring.targetIndex];
        float neighborInvMass = PhysicsData[spring.targetIndex].inverseMass;

        float3 deltaP = currentPos - neighborPos;
        float dist = length(deltaP);
        
        if (dist > 0.0001f)
        {
            float3 dir = deltaP / dist;
            float constraint = dist - spring.restLength;
            
            float invMassSum = p.inverseMass + neighborInvMass;
            if (invMassSum > 0.0f)
            {
                // XPBD Formulation
                float alphaTilde = spring.compliance / (_DeltaTime * _DeltaTime);
                float lambda = -constraint / (invMassSum + alphaTilde);
                
                // Apply Over-Relaxation
                posDelta += p.inverseMass * lambda * dir * omega;
                weightCount += 1.0f;
            }
        }
    }
    
    if (weightCount > 0.0f)
    {
        PredictedPositions[id.x] += posDelta / weightCount;
    }

    // --- STATIC COLLISIONS (XPBD Positional Push) ---
    for (uint c = 0; c < p.colliderCount; c++)
    {
        ClothCollider col = Colliders[p.colliderStart + c];
        float3 normal = float3(0, 0, 0);
        float penetration = 0;
        
        float3 pos = PredictedPositions[id.x]; 

        if (col.type == 0) // Sphere
        {
            float3 dir = pos - col.posA;
            float dist = max(length(dir), 0.0001f);
            if (dist < col.radius) { normal = dir / dist; penetration = col.radius - dist; }
        }
        else if (col.type == 1) // Capsule
        {
            float3 ab = col.posB - col.posA;
            float t = saturate(dot(pos - col.posA, ab) / max(dot(ab, ab), 0.0001f));
            float3 closest = col.posA + t * ab;
            float3 dir = pos - closest;
            float dist = max(length(dir), 0.0001f);
            if (dist < col.radius) { normal = dir / dist; penetration = col.radius - dist; }
        }
        else if (col.type == 2) // Box
        {
            float3 localPos = mul(col.worldToLocal, float4(pos, 1.0)).xyz;
            float3 d = abs(localPos) - col.extents;
            float dist = length(max(d, 0.0)) + min(max(d.x, max(d.y, d.z)), 0.0);
            if (dist < 0.0) 
            {
                float3 normalLocal = float3(0,0,0);
                if (d.x > d.y && d.x > d.z) normalLocal = float3(sign(localPos.x), 0, 0);
                else if (d.y > d.z) normalLocal = float3(0, sign(localPos.y), 0);
                else normalLocal = float3(0, 0, sign(localPos.z));

                normal = normalize(mul((float3x3)col.localToWorld, normalLocal));
                penetration = -dist;
            }
        }

        // If inside a collider, instantly push the predicted position out
        if (penetration > 0.0)
        {
            PredictedPositions[id.x] += normal * penetration;
        }
    }
} // End of CSSolveConstraints

// ==========================================
// --- 3. INTEGRATE (UPDATE VELOCITY) ---
// ==========================================
[numthreads(64, 1, 1)]
void CSIntegrate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _VertexCount) return;
    
    PhysicsState p = PhysicsData[id.x];
    if (p.inverseMass > 0.0f)
    {
        // 1. Derive the raw new velocity via Verlet
        float3 newVelocity = (PredictedPositions[id.x] - Positions[id.x]) / _DeltaTime;
        
        // 2. Structural Friction (Velocity Smoothing)
        // Averages velocity with neighbors to simulate thread friction.
        // Reading from PhysicsData here creates a lock-free asynchronous blur.
        int4 adj = Adjacency[id.x];
        float3 avgVel = newVelocity;
        float count = 1.0f;

        if (adj.x != -1) { avgVel += PhysicsData[adj.x].velocity; count += 1.0f; }
        if (adj.y != -1) { avgVel += PhysicsData[adj.y].velocity; count += 1.0f; }
        if (adj.z != -1) { avgVel += PhysicsData[adj.z].velocity; count += 1.0f; }
        if (adj.w != -1) { avgVel += PhysicsData[adj.w].velocity; count += 1.0f; }

        avgVel /= count;
        
        // Blend factor: 0.1 is standard friction. Higher values (0.2) = heavy canvas.
        newVelocity = lerp(newVelocity, avgVel, 0.1f);
        
        // 3. Quadratic Air Drag (Aggressively kills fast pendulum swings)
        float speed = length(newVelocity);
        newVelocity -= newVelocity * min(speed * _Drag * _DeltaTime, 1.0f);
        
        // 4. Global Linear Drag (Standard air resistance)
        newVelocity *= exp(-_Drag * _DeltaTime);
        
        // Apply final state
        p.velocity = newVelocity;
        Positions[id.x] = PredictedPositions[id.x];
        PhysicsData[id.x] = p;
    }
}
// ==========================================
// --- 4. ATOMIC-FREE NORMALS ---
// ==========================================
[numthreads(64, 1, 1)]
void CSComputeNormals(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _VertexCount) return;

    int4 adj = Adjacency[id.x];
    float3 p = Positions[id.x];
    float3 n = float3(0,0,0);

    // Reconstruct tangent/bitangent locally using neighbors.
    // If a neighbor is missing (edge of grid), fallback to mirroring the opposite side.
    float3 left =  (adj.x != -1) ? Positions[adj.x] - p : p - Positions[adj.y];
    float3 right = (adj.y != -1) ? Positions[adj.y] - p : p - left;
    float3 up =    (adj.z != -1) ? Positions[adj.z] - p : p - Positions[adj.w];
    float3 down =  (adj.w != -1) ? Positions[adj.w] - p : p - up;

    n += cross(right, up);
    n += cross(left, down);
    n += cross(up, left);
    n += cross(down, right);

    float len = length(n);
    Normals[id.x] = (len > 0.0001f) ? n / len : float3(0, 0, -1);
}